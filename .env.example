# Supabase (S-012)
# CLI 2.101+ : nouveau système de clés. NEXT_PUBLIC_SUPABASE_ANON_KEY reçoit la clé
# « publishable » (sb_publishable_…, publique), SUPABASE_SERVICE_ROLE_KEY la clé
# « secret » (sb_secret_…, serveur uniquement, bypass RLS). Local : `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Garde admin (/admin) — whitelist d'emails séparés par des virgules.
# Vide ou non défini = personne n'est admin. Les writes catalogue passent par
# le service role serveur, jamais par la session client.
ADMIN_EMAILS=

# Price feed — Firecrawl (S-008)
FIRECRAWL_API_KEY=
